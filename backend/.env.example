# RailRoute AI - environment template
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
# The .env file is git-ignored; never commit real credentials.

# REQUIRED: RailCore API key (https://railcore.tech)
RAILCORE_API_KEY=rk_live_your_api_key_here

# OPTIONAL overrides (defaults shown)
RAILCORE_BASE_URL=https://ir.railcore.tech/v1
RAILCORE_TIMEOUT_SECONDS=15
RAILCORE_MAX_RETRIES=2

# OPTIONAL: HMAC-SHA256 signing secret.
# Only required for Growth/Scale/Enterprise plan keys. Leave empty otherwise.
# RAILCORE_HMAC_SECRET=

# OPTIONAL: same-train combination search budgets (defaults shown).
# These are computational safeguards, NOT a maximum number of seat changes.
# When a budget stops a search early, the API returns a PARTIAL_* status.
# SEARCH_MAX_TRAINS=5
# SEARCH_MAX_API_REQUESTS=40
# SEARCH_MAX_CREDITS=80
# SEARCH_TIME_BUDGET_SECONDS=30
# SEARCH_MAX_COMBINATIONS_PER_TRAIN=25
# SEARCH_MAX_RESULTS=50
# SEARCH_SCHEDULE_CACHE_TTL_SECONDS=600
# SEARCH_DISCOVERY_CACHE_TTL_SECONDS=300
# Optional client-side pacing between provider calls (seconds) to stay
# under the provider's 10-requests/minute free-tier limit. 0 = off.
# SEARCH_MIN_REQUEST_INTERVAL_SECONDS=0

# OPTIONAL: train-change connection search settings (phase 3, defaults shown).
# Transfer window and search scope:
# TRAIN_CHANGE_MIN_TRANSFER_BUFFER_MINUTES=30
# TRAIN_CHANGE_MAX_TRANSFER_WAIT_MINUTES=720
# TRAIN_CHANGE_SEARCH_HORIZON_DAYS=2
# Computational safeguards (NOT train-change limits); the engine explores
# connections of ANY depth within these budgets and reports truncation:
# TRAIN_CHANGE_MAX_DISCOVERY_PAIRS=20
# TRAIN_CHANGE_MAX_TRAINS=15
# TRAIN_CHANGE_MAX_API_REQUESTS=40
# TRAIN_CHANGE_MAX_CREDITS=120
# TRAIN_CHANGE_TIME_BUDGET_SECONDS=30
# TRAIN_CHANGE_MAX_EXPANDED_STATES=300
# TRAIN_CHANGE_MAX_JOURNEYS=25
# TRAIN_CHANGE_MAX_RESULTS=20

# OPT-IN live API tests: never run by default; consume real credits.
# RUN_LIVE_API_TESTS=0

# OPTIONAL: mixed journey search settings (phase 4, defaults shown).
# Transfer window (same validation rules as the train-change engine; the
# same-train seat-change continuations need no window - the passenger
# stays onboard):
# MIXED_MIN_TRANSFER_BUFFER_MINUTES=30
# MIXED_MAX_TRANSFER_WAIT_MINUTES=720
# MIXED_SEARCH_HORIZON_DAYS=2
# Computational safeguards (NOT seat-change or train-change limits); the
# engine explores journeys of ANY shape within these budgets and reports
# truncation:
# MIXED_MAX_DISCOVERY_PAIRS=20
# MIXED_MAX_TRAINS=15
# MIXED_MAX_API_REQUESTS=40
# MIXED_MAX_CREDITS=120
# MIXED_TIME_BUDGET_SECONDS=30
# MIXED_MAX_EXPANDED_STATES=300
# MIXED_MAX_JOURNEYS=25
# MIXED_MAX_RESULTS=20

# OPTIONAL: unified journey search settings (phase 5, defaults shown).
# ONE shared envelope for a whole unified search across the phase 2/3/4
# engines (POST /api/v1/journeys/search): the counters are never reset
# between engines, and an engine whose turn arrives after the envelope is
# exhausted is skipped with an honestly reported reason:
# UNIFIED_MAX_API_REQUESTS=60
# UNIFIED_MAX_CREDITS=150
# UNIFIED_TIME_BUDGET_SECONDS=45
# UNIFIED_MAX_RESULTS=30
# UNIFIED_SCHEDULE_CACHE_TTL_SECONDS=600
# UNIFIED_DISCOVERY_CACHE_TTL_SECONDS=300
# UNIFIED_MIN_REQUEST_INTERVAL_SECONDS=0
