{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "api.index:app",
      "functions": {
        "api/index.py": {
          "maxDuration": 60
        }
      }
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "backend" } }
  ]
}
